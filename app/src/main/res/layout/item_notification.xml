<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_notif"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/surface_container_lowest"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Icon background circle -->
        <FrameLayout
            android:id="@+id/fl_icon_bg"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_notif_icon_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_notif_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_notif_bell"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- Unread dot -->
        <View
            android:id="@+id/view_unread_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_unread_dot"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Title -->
        <TextView
            android:id="@+id/tv_notif_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="16dp"
            android:text="Judul Notifikasi"
            android:textColor="@color/on_surface"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintStart_toEndOf="@id/fl_icon_bg"
            app:layout_constraintEnd_toStartOf="@id/view_unread_dot"
            app:layout_constraintTop_toTopOf="@id/fl_icon_bg" />

        <!-- Body -->
        <TextView
            android:id="@+id/tv_notif_body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:text="Isi notifikasi"
            android:textColor="@color/on_surface_variant"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.3"
            android:fontFamily="sans-serif"
            app:layout_constraintStart_toEndOf="@id/fl_icon_bg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_notif_title" />

        <!-- Time -->
        <TextView
            android:id="@+id/tv_notif_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:text="5 mnt yang lalu"
            android:textColor="@color/on_surface_variant"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintStart_toEndOf="@id/fl_icon_bg"
            app:layout_constraintTop_toBottomOf="@id/tv_notif_body" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>